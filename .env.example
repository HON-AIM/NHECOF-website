# ──────────────────────────────────────────────
# NHECOF Website — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env or any file containing real values.
# ──────────────────────────────────────────────

# ── Server-only (never exposed to the browser) ──

# Sanity
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Email (Resend)
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=
OUTREACH_RECIPIENT_EMAIL=
PARTNERSHIP_RECIPIENT_EMAIL=
# From address for form emails (must be a sender verified in Resend)
FORMS_EMAIL_FROM=
# Delivery-failure fallback contact shown to users when email sending fails
CONTACT_FALLBACK_EMAIL=
CONTACT_FALLBACK_PHONE=
CONTACT_FALLBACK_WHATSAPP=

# Bot protection (Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring (optional for launch)
SENTRY_DSN=

# ── Weekly content review reminders (scripts/send-review-reminders.mjs) ──
# Run by .github/workflows/review-reminders.yml every Monday. Not used by the
# website itself, so these live outside the app's env validation.
# Who receives the weekly "content due for review" email.
CONTENT_MANAGER_EMAIL=
# Sanity Studio project/dataset the reminder reads. Defaults to `development`
# and refuses to read `production` unless --allow-production is passed.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=development
# Override the 30-day look-ahead window (rarely needed).
REVIEW_REMINDER_WITHIN_DAYS=30

# ── Public (accessible in the browser via NEXT_PUBLIC_*) ──

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Programme detail pages (/what-we-do/:slug): set to "true" to enable
NEXT_PUBLIC_ENABLE_PROGRAMME_DETAILS=false

# Launch gate: set to "true" to allow search-engine indexing
NEXT_PUBLIC_IS_LIVE=false
